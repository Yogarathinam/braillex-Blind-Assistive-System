val BRAILLE_DICT = mapOf(
    'A' to listOf(1,0,0,0,0,0), 'B' to listOf(1,1,0,0,0,0), 'C' to listOf(1,0,0,1,0,0), 'D' to listOf(1,0,0,1,1,0),
    'E' to listOf(1,0,0,0,1,0), 'F' to listOf(1,1,0,1,0,0), 'G' to listOf(1,1,0,1,1,0), 'H' to listOf(1,1,0,0,1,0),
    'I' to listOf(0,1,0,1,0,0), 'J' to listOf(0,1,0,1,1,0), 'K' to listOf(1,0,1,0,0,0), 'L' to listOf(1,1,1,0,0,0),
    'M' to listOf(1,0,1,1,0,0), 'N' to listOf(1,0,1,1,1,0), 'O' to listOf(1,0,1,0,1,0), 'P' to listOf(1,1,1,1,0,0),
    'Q' to listOf(1,1,1,1,1,0), 'R' to listOf(1,1,1,0,1,0), 'S' to listOf(0,1,1,1,0,0), 'T' to listOf(0,1,1,1,1,0),
    'U' to listOf(1,0,1,0,0,1), 'V' to listOf(1,1,1,0,0,1), 'W' to listOf(0,1,0,1,1,1), 'X' to listOf(1,0,1,1,0,1),
    'Y' to listOf(1,0,1,1,1,1), 'Z' to listOf(1,0,1,0,1,1), ' ' to listOf(0,0,0,0,0,0)
