@Composable
fun BrailleDotsDisplay(chord: List<Int>) {
    val order = listOf(0, 3, 1, 4, 2, 5) // Matches braille physical numbering
    Column(verticalArrangement = Arrangement.spacedBy(16.dp)) {
        for (row in 0..2) {
            Row(horizontalArrangement = Arrangement.spacedBy(40.dp)) {
                val leftIdx = order[row * 2]
                val rightIdx = order[row * 2 + 1]

                // Pass dot numbers (1 to 6) to the UI for correct Semantic descriptions
                Dot(dotNumber = leftIdx + 1, isActive = chord[leftIdx] == 1)
                Dot(dotNumber = rightIdx + 1, isActive = chord[rightIdx] == 1)
            }
        }
    }
}

@Composable
fun Dot(dotNumber: Int, isActive: Boolean) {
    Box(
        modifier = Modifier
            .size(56.dp) // Larger 56dp size for better tactile representation and touch target
            .clip(CircleShape)
            .background(if (isActive) Color.White else Color.DarkGray)
            .border(4.dp, if (isActive) Color.White else Color.Gray, CircleShape)
            .shadow(if (isActive) 12.dp else 0.dp, CircleShape)
            // Critical accessibility upgrade: TalkBack explicitly reads dot status.
            .semantics {
                contentDescription = "Braille Dot $dotNumber, ${if (isActive) "Active" else "Inactive"}"
            }
    )
}

