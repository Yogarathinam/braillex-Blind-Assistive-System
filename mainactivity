                        viewModel.menuIndex = index
                        viewModel.actionSelect()
                    }
                    .border(
                        width = if (isSelected) 4.dp else 2.dp,
                        color = if (isSelected) Color.White else Color.DarkGray,
                        shape = RoundedCornerShape(16.dp)
                    )
                    .background(if (isSelected) Color.White else Color.Black)
                    .padding(20.dp),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    text = option.second.uppercase(),
                    color = if (isSelected) Color.Black else Color.Gray,
                    fontWeight = FontWeight.Black,
                    fontSize = 20.sp,
                    textAlign = TextAlign.Center
                )
            }
        }

        Spacer(modifier = Modifier.height(32.dp))
        // On-screen hardware simulation clearly labeled
        Row(horizontalArrangement = Arrangement.spacedBy(16.dp)) {
            OutlinedButton(
                onClick = { viewModel.actionNext() },
                colors = ButtonDefaults.outlinedButtonColors(contentColor = Color.White)
            ) { Text("Simulate C (Next)") }
            OutlinedButton(
                onClick = { viewModel.actionSelect() },
                colors = ButtonDefaults.outlinedButtonColors(contentColor = Color.White)
            ) { Text("Simulate A (Select)") }
        }
    }
