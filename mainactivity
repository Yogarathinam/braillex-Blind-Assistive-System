fun MenuScreen(viewModel: BrailleXViewModel) {
    Column(horizontalAlignment = Alignment.CenterHorizontally, modifier = Modifier.fillMaxWidth(0.9f)) {
        Text(
            "MAIN MENU",
            fontSize = 28.sp,
            fontWeight = FontWeight.Black,
            modifier = Modifier
                .padding(bottom = 24.dp)
                .semantics { heading() }
        )
        MENU_OPTIONS.forEachIndexed { index, option ->
            val isSelected = index == viewModel.menuIndex
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(vertical = 8.dp)
                    .clip(RoundedCornerShape(16.dp))
                    // Accessibility specific click handling
