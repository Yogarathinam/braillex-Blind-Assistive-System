val REVERSE_DICT = BRAILLE_DICT.entries.associate { it.value.joinToString(",") to it.key }

enum class AppState { DISCONNECTED, MENU, BRAILLE_TO_TEXT, TEXT_TO_BRAILLE, TUTOR_MODE, AI_MODE, DEBUG }
val MENU_OPTIONS = listOf(
    AppState.BRAILLE_TO_TEXT to "Write Mode",
    AppState.TEXT_TO_BRAILLE to "Read Mode",
    AppState.TUTOR_MODE to "Tutor Mode",
    AppState.AI_MODE to "AI Assistant",
    AppState.DEBUG to "Developer Debug"
)
val READ_MODES = listOf("MANUAL", "SENSOR", "AUTO")

// --- VIEWMODEL ---
@SuppressLint("MissingPermission") // Permissions handled in Manifest & Activity level
class BrailleXViewModel : ViewModel(), TextToSpeech.OnInitListener {
    var appState by mutableStateOf(AppState.DISCONNECTED)
    var menuIndex by mutableStateOf(0)
    var isAutoMode by mutableStateOf(false)
    var currentReadMode by mutableStateOf(0)

    var b2tText by mutableStateOf("")
    var t2bTargetText by mutableStateOf("HELLO")
    var t2bIndex by mutableStateOf(0)
    var isT2BStarted by mutableStateOf(false)
    var tutorTarget by mutableStateOf('A')
    var tutorScore by mutableStateOf(0)
    var chordBuffer by mutableStateOf(listOf(0, 0, 0, 0, 0, 0))
    var aiResponse by mutableStateOf("")

    var serialLogs = mutableStateListOf<String>()

    private var tts: TextToSpeech? = null
    private var autoSubmitJob: Job? = null
    private var idleJob: Job? = null

    // Touch & Nav tracking
    private val touchStates = mutableListOf(0, 0, 0)
    private var wasAnyTouchActive = false

    // Bluetooth Variables
    private var btSocket: BluetoothSocket? = null
    private var btInput: InputStream? = null
    private var btOutput: OutputStream? = null
    private var isBtConnected = false

    fun initTTS(context: Context) {
        tts = TextToSpeech(context, this)
    }

    override fun onInit(status: Int) {
        if (status == TextToSpeech.SUCCESS) {
            tts?.language = Locale.US
        }
    }

    fun speak(text: String, flush: Boolean = true) {
        val queueMode = if (flush) TextToSpeech.QUEUE_FLUSH else TextToSpeech.QUEUE_ADD
        tts?.speak(text, queueMode, null, null)
        addLog("TTS: $text", "system")
    }

    fun addLog(msg: String, type: String = "info") {
        viewModelScope.launch {
            if (serialLogs.size > 50) serialLogs.removeAt(serialLogs.size - 1)
            serialLogs.add(0, "[$type] $msg")
        }
    }

    // --- HARDWARE ACTIONS ---
    fun sendSerial(cmd: String) {
        addLog("TX: $cmd", "tx")
        if (isBtConnected) {
            viewModelScope.launch(Dispatchers.IO) {
                try {
                    btOutput?.write(("$cmd\n").toByteArray())
                } catch (e: Exception) {
                    withContext(Dispatchers.Main) {
                        addLog("TX Error: ${e.message}", "error")
                    }
                }
            }
        }
    }

    private fun sendServo(id: Int, angle: Int) {
        sendSerial("S$id:$angle")
    }

    fun connectDevice(context: Context) {
        viewModelScope.launch(Dispatchers.IO) {
            try {
                addLog("CONNECT BUTTON PRESSED", "system")

                val bluetoothManager = context.getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager
                val adapter = bluetoothManager.adapter ?: throw Exception("Bluetooth not supported")

                val devices = adapter.bondedDevices.toList()

                if (devices.isEmpty()) {
                    throw Exception("No paired Bluetooth devices found")
                }

                addLog("Paired devices: ${devices.map { it.name }}", "system")

                val device = devices.firstOrNull { it.name?.contains("BrailleX") == true }
                    ?: throw Exception("BrailleX device not found")

                // Standard SPP UUID
                val uuid = UUID.fromString("00001101-0000-1000-8000-00805f9b34fb")

                // IMPORTANT: Cancel discovery before attempting to connect
                adapter.cancelDiscovery()

                addLog("Trying to connect to ${device.name}", "system")

                try {
                    btSocket = device.createRfcommSocketToServiceRecord(uuid)
                    btSocket?.connect()
                } catch (e: Exception) {
                    addLog("Secure socket failed, trying fallback", "system")

                    try {
                        val method = device.javaClass.getMethod(
                            "createRfcommSocket",
                            Int::class.javaPrimitiveType
                        )
                        btSocket = method.invoke(device, 1) as BluetoothSocket
                        btSocket?.connect()
                    } catch (fallbackEx: Exception) {
                        throw Exception("Both connection methods failed.")
                    }
                }

                addLog("Bluetooth socket connected", "system")

                btInput = btSocket?.inputStream
                btOutput = btSocket?.outputStream
                isBtConnected = true

                withContext(Dispatchers.Main) {
                    appState = AppState.MENU
                    speak("BrailleX connected via Bluetooth. Three navigation buttons on top. Six braille dots below. System is entirely controlled via the navigation buttons.")
                    resetIdleTimer()
                }

                startBluetoothReadThread()

            } catch (e: Exception) {
                withContext(Dispatchers.Main) {
                    addLog("Connection Failed: ${e.message}", "error")
                    speak("Connection failed. Check Bluetooth pairing.")
                }
            }
        }
    }

    private fun startBluetoothReadThread() {
        Thread {
            val buffer = ByteArray(1024)
            var leftover = ""

            while (isBtConnected) {
                try {
                    val bytes = btInput?.read(buffer) ?: -1
                    if (bytes > 0) {
                        val chunk = String(buffer, 0, bytes)
                        val fullStream = leftover + chunk
                        val messages = fullStream.split("\n")

                        // Keep the last part if it doesn't end with a newline
                        leftover = if (fullStream.endsWith("\n")) "" else messages.last()

                        // Process complete lines
                        for (i in 0 until (if (leftover.isEmpty()) messages.size else messages.size - 1)) {
                            val msg = messages[i].trim()
                            if (msg.isNotEmpty()) {
                                viewModelScope.launch(Dispatchers.Main) {
                                    handleIncomingSerial(msg)
                                }
                            }
                        }
                    }
                } catch (e: Exception) {
                    isBtConnected = false
                    viewModelScope.launch(Dispatchers.Main) {
                        addLog("BT Disconnected", "error")
                        appState = AppState.DISCONNECTED
                    }
                    break
                }
            }
        }.start()
    }

    fun handleIncomingSerial(data: String) {
        addLog(data, "rx")
        resetIdleTimer()

        // 1. BRAILLE BUTTONS
        val btnMatch = Regex("^B([1-6])_(PRESS|RELEASE)$").find(data)
        if (btnMatch != null) {
            val dotIndex = btnMatch.groupValues[1].toInt() - 1
            val isPress = btnMatch.groupValues[2] == "PRESS"

            if (isPress) {
                val newBuffer = chordBuffer.toMutableList()
                newBuffer[dotIndex] = if (newBuffer[dotIndex] == 1) 0 else 1
                chordBuffer = newBuffer

                if (chordBuffer[dotIndex] == 1) {
                    speak("Dot ${dotIndex + 1}")
                    sendServo(dotIndex + 1, SERVO_UP)
                } else {
                    speak("Dot ${dotIndex + 1} released")
                    sendServo(dotIndex + 1, SERVO_DOWN)
                }
                sendSerial("VIB:DOT")
                if (isAutoMode) resetAutoSubmitTimer()
            }
            return
        }

        // 2. TOUCH SENSORS
        val touchMatch = Regex("^T([1-3])_(PRESS|RELEASE)$").find(data)
        if (touchMatch != null) {
            val index = touchMatch.groupValues[1].toInt() - 1
            val isPress = touchMatch.groupValues[2] == "PRESS"
            touchStates[index] = if (isPress) 1 else 0

            val anyTouchActive = touchStates.any { it == 1 }
            if (wasAnyTouchActive && !anyTouchActive) {
                // Lift hand logic
                if (appState == AppState.TEXT_TO_BRAILLE && currentReadMode == 1 && isT2BStarted) {
                    actionNext()
                } else if (isAutoMode && (appState == AppState.BRAILLE_TO_TEXT || appState == AppState.AI_MODE)) {
                    submitBrailleToText()
                }
            }
            wasAnyTouchActive = anyTouchActive
            return
        }

        // 3. NAV BUTTONS
        val navMatch = Regex("^([ABC])_(PRESS)$").find(data)
        if (navMatch != null) {
            val btn = navMatch.groupValues[1]
            when (btn) {
                "A" -> actionSelect()
                "B" -> actionBack()
                "C" -> actionNext()
            }
        }
    }

    // --- CORE LOGIC ---
    fun actionSelect() {
        sendSerial("VIB:CONFIRM")
        when (appState) {
            AppState.MENU -> {
                appState = MENU_OPTIONS[menuIndex].first
                speak("Opening ${MENU_OPTIONS[menuIndex].second}")
                resetContext()
            }
            AppState.BRAILLE_TO_TEXT -> submitBrailleToText()
            AppState.TUTOR_MODE -> submitTutorChord()
            AppState.AI_MODE -> {
                if (chordBuffer.any { it == 1 }) submitBrailleToText()
                else if (b2tText.isNotEmpty()) askAI(b2tText)
            }
            AppState.TEXT_TO_BRAILLE -> {
                if (!isT2BStarted) {
                    isT2BStarted = true
                    readCurrentT2BLetter()
                } else actionNext()
            }
            else -> {}
        }
    }

    fun actionBack() {
        sendSerial("VIB:CANCEL")
        if (appState == AppState.MENU) {
            speak("Already at main menu")
        } else {
            speak("Back to menu")
            appState = AppState.MENU
        }
    }

    fun actionNext() {
        when (appState) {
            AppState.MENU -> {
                menuIndex = (menuIndex + 1) % MENU_OPTIONS.size
                speak("Menu ${MENU_OPTIONS[menuIndex].second}")
            }
            AppState.BRAILLE_TO_TEXT -> speak(if (b2tText.isEmpty()) "No text" else "Text is $b2tText")
            AppState.TEXT_TO_BRAILLE -> {
                if (!isT2BStarted) {
                    isT2BStarted = true
                    readCurrentT2BLetter()
                } else if (t2bIndex < t2bTargetText.length - 1) {
                    t2bIndex++
                    readCurrentT2BLetter()
                } else {
                    speak("End of text")
                }
            }
            AppState.TUTOR_MODE -> {
                speak("Skipping letter")
                nextTutorLetter()
            }
            else -> {}
        }
    }

    fun submitBrailleToText() {
        if (chordBuffer.all { it == 0 }) return
        val letter = REVERSE_DICT[chordBuffer.joinToString(",")]
        if (letter != null) {
            b2tText += letter
            speak("Character ${if (letter == ' ') "space" else letter}")
        } else {
            speak("Unknown character")
            sendSerial("VIB:ERROR")
        }
        chordBuffer = listOf(0, 0, 0, 0, 0, 0)
        resetServos()
    }

    private fun readCurrentT2BLetter() {
        if (t2bTargetText.isEmpty()) return
        val letter = t2bTargetText[t2bIndex]
        speak("Letter ${if (letter == ' ') "space" else letter}")
        val chord = BRAILLE_DICT[letter] ?: listOf(0, 0, 0, 0, 0, 0)
        sendSerial("CHORD:${chord.joinToString("")}")
        resetAutoSubmitTimer()
    }

    private fun nextTutorLetter() {
        val keys = BRAILLE_DICT.keys.filter { it != ' ' }
        tutorTarget = keys.random()
        chordBuffer = listOf(0, 0, 0, 0, 0, 0)
        speak("Type letter $tutorTarget")
    }

    private fun submitTutorChord() {
        val target = BRAILLE_DICT[tutorTarget]
        val isCorrect = chordBuffer == target
        val entered = REVERSE_DICT[chordBuffer.joinToString(",")] ?: "unknown"

        if (isCorrect) {
            tutorScore++
            speak("$entered. Correct. Score $tutorScore")
            viewModelScope.launch {
                delay(2000)
                nextTutorLetter()
            }
        } else {
            speak("$entered. Incorrect. Try again.")
            sendSerial("VIB:ERROR")
        }
        chordBuffer = listOf(0, 0, 0, 0, 0, 0)
        resetServos()
    }

    fun askAI(prompt: String) {
        aiResponse = "Thinking..."
        viewModelScope.launch(Dispatchers.IO) {
            try {
                val url = URL("https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=$API_KEY")
                val conn = url.openConnection() as HttpURLConnection
                conn.requestMethod = "POST"
                conn.setRequestProperty("Content-Type", "application/json")
                conn.doOutput = true

                val payload = """
                    {"contents":[{"parts":[{"text":"You are BrailleX, an assistant for a blind user. Answer very shortly in simple words, max 10 words. Prompt: $prompt"}]}]}
                """.trimIndent()

                OutputStreamWriter(conn.outputStream).use { it.write(payload) }

                val responseStr = conn.inputStream.bufferedReader().use { it.readText() }
                val json = JSONObject(responseStr)
                val text = json.getJSONArray("candidates")
                    .getJSONObject(0)
                    .getJSONObject("content")
                    .getJSONArray("parts")
                    .getJSONObject(0)
                    .getString("text")

                withContext(Dispatchers.Main) {
                    aiResponse = text
                    speak(text)
                    sendSerial("TXT:${text.take(16)}")
                    b2tText = ""
                }
            } catch (e: Exception) {
                withContext(Dispatchers.Main) {
                    aiResponse = "Network Error"
                    speak("AI Error")
                    sendSerial("VIB:ERROR")
                }
            }
        }
    }

    private fun resetContext() {
        b2tText = ""
        chordBuffer = listOf(0, 0, 0, 0, 0, 0)
        aiResponse = ""
        t2bIndex = 0
        isT2BStarted = false
        if (appState == AppState.TUTOR_MODE) {
            tutorScore = 0
            nextTutorLetter()
        }
        resetServos()
    }

    private fun resetServos() {
        for (i in 1..6) sendServo(i, SERVO_DOWN)
    }

    private fun resetAutoSubmitTimer() {
        autoSubmitJob?.cancel()
        if (appState == AppState.TEXT_TO_BRAILLE && currentReadMode == 2 && isT2BStarted) {
            autoSubmitJob = viewModelScope.launch {
                delay(3000)
                actionNext()
            }
        } else if (isAutoMode && (appState == AppState.BRAILLE_TO_TEXT || appState == AppState.AI_MODE)) {
            autoSubmitJob = viewModelScope.launch {
                delay(2500)
                if (chordBuffer.any { it == 1 }) submitBrailleToText()
            }
        }
    }

    private fun resetIdleTimer() {
        idleJob?.cancel()
        if (appState != AppState.DISCONNECTED) {
            idleJob = viewModelScope.launch {
                delay(15000)
                speak("Current state is ${appState.name}")
            }
        }
    }

    override fun onCleared() {
        super.onCleared()
        try {
            btSocket?.close()
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }
}

// --- UI COMPONENTS (JETPACK COMPOSE) ---
class MainActivity : ComponentActivity() {

    private val bluetoothPermissionLauncher =
        registerForActivityResult(ActivityResultContracts.RequestMultiplePermissions()) { permissions ->
            val granted =
                permissions[android.Manifest.permission.BLUETOOTH_CONNECT] == true &&
                        permissions[android.Manifest.permission.BLUETOOTH_SCAN] == true
            if (!granted) {
                Log.e("BrailleX", "Bluetooth permission denied")
            }
        }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        bluetoothPermissionLauncher.launch(
            arrayOf(
                android.Manifest.permission.BLUETOOTH_CONNECT,
                android.Manifest.permission.BLUETOOTH_SCAN
            )
        )

        setContent {
            val viewModel: BrailleXViewModel = viewModel()
            val context = LocalContext.current

            LaunchedEffect(Unit) {
                viewModel.initTTS(context)
            }

            // Speech Recognizer Launcher
            val speechLauncher = rememberLauncherForActivityResult(
                contract = ActivityResultContracts.StartActivityForResult()
            ) { result ->
                if (result.resultCode == android.app.Activity.RESULT_OK) {
                    val data = result.data?.getStringArrayListExtra(RecognizerIntent.EXTRA_RESULTS)
                    val text = data?.get(0) ?: ""
                    if (viewModel.appState == AppState.TEXT_TO_BRAILLE) {
                        viewModel.t2bTargetText = text.uppercase()
                        viewModel.speak("Text loaded. Press A to start.")
                    } else if (viewModel.appState == AppState.AI_MODE) {
                        viewModel.askAI(text)
                    }
                }
            }

            MaterialTheme(
                colorScheme = darkColorScheme(
                    background = Color.Black,
                    surface = Color.Black,
                    onBackground = Color.White,
                    onSurface = Color.White
                )
            ) {
                Scaffold(
                    topBar = { TopHeader(viewModel) },
                    containerColor = Color.Black,
                    contentColor = Color.White
                ) { paddingValues ->
                    Box(
                        modifier = Modifier
                            .fillMaxSize()
                            .padding(paddingValues)
                            .padding(16.dp),
                        contentAlignment = Alignment.Center
                    ) {
                        // Smooth animated transitions for accessibility & UX
                        AnimatedContent(
                            targetState = viewModel.appState,
                            transitionSpec = { fadeIn(tween(300)) togetherWith fadeOut(tween(300)) },
                            label = "ScreenTransition"
                        ) { state ->
                            when (state) {
                                AppState.DISCONNECTED -> DisconnectedScreen(viewModel)
                                AppState.MENU -> MenuScreen(viewModel)
                                AppState.BRAILLE_TO_TEXT -> WriteScreen(viewModel)
                                AppState.TEXT_TO_BRAILLE -> ReadScreen(viewModel, onDictate = {
                                    val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
                                        putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
                                    }
                                    speechLauncher.launch(intent)
                                })
                                AppState.TUTOR_MODE -> TutorScreen(viewModel)
                                AppState.AI_MODE -> AIScreen(viewModel, onDictate = {
                                    val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
                                        putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
                                    }
                                    speechLauncher.launch(intent)
                                })
                                AppState.DEBUG -> DebugScreen(viewModel)
                            }
                        }
                    }
                }
            }
        }
    }
}

